generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
  FAILED
}

enum CreditTransactionType {
  FREE_GRANT
  PURCHASE
  GENERATION
  REFUND
  BONUS
  ADMIN_ADD
  ADMIN_REMOVE
  EXPIRATION
}

enum GenerationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum GenerationVariant {
  A
  B
}

enum ReferralStatus {
  PENDING
  REWARDED
  REJECTED
}

enum PendingMintGrantStatus {
  PENDING
  REDEEMED
  CANCELLED
}

model User {
  id                 String              @id @default(cuid())
  clerkUserId        String              @unique
  email              String?
  name               String?
  role               UserRole            @default(USER)
  status             UserStatus          @default(ACTIVE)
  referralCode       String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  creditAccount      CreditAccount?
  creditBuckets      CreditBucket[]
  creditTransactions CreditTransaction[]
  payments           Payment[]
  generations        Generation[]
  brandKit           BrandKit?
  adminLogs          AdminLog[]          @relation("AdminActorLogs")
  mintGrantsCreated  PendingMintGrant[]  @relation("MintGrantAdmin")
  mintGrantsRedeemed PendingMintGrant[]  @relation("MintGrantUser")
  supportTickets     SupportTicket[]
  generationGroups   GenerationGroup[]
  referralsMade      Referral[]          @relation("Referrer")
  referralReceived   Referral?           @relation("Referred")
  promoRedemptions   PromoRedemption[]
  notifications      Notification[]
}

model Plan {
  id             String    @id @default(cuid())
  code           String    @unique
  name           String
  priceFcfa      Int
  mintAmount     Int
  durationDays   Int?
  editableExport Boolean   @default(false)
  active         Boolean   @default(true)
  offerDays      Int?
  offerEndsAt    DateTime?
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payments       Payment[]
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  planId         String
  orderId        String        @unique
  tokenPay       String?       @unique
  amountFcfa     Int
  provider       String        @default("MONEY_FUSION")
  status         PaymentStatus @default(PENDING)
  rawStatus      String?
  rawResponse    Json?
  webhookState   String?
  creditedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  plan           Plan            @relation(fields: [planId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  supportTickets SupportTicket[]
}

model CreditAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  balance      Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id])
}

model CreditBucket {
  id                 String   @id @default(cuid())
  userId             String
  sourceTransactionId String
  sourceType         CreditTransactionType
  totalAmount        Int
  remainingAmount    Int
  expiresAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt, remainingAmount])
}

model CreditTransaction {
  id            String                @id @default(cuid())
  userId        String
  type          CreditTransactionType
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  reference     String?
  metadata      Json?
  createdAt     DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model BrandKit {
  id        String   @id @default(cuid())
  userId    String   @unique
  colors    String[]
  logoUrl   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model GenerationGroup {
  id                   String       @id @default(cuid())
  userId               String
  selectedGenerationId String?
  mintCost             Int          @default(1)
  rodiCostA            Float?
  rodiCostB            Float?
  rodiCostTotal        Float?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  user                 User         @relation(fields: [userId], references: [id])
  generations          Generation[]

  @@index([userId, createdAt])
}

model Generation {
  id             String             @id @default(cuid())
  userId         String
  mintCost       Int                @default(1)
  brief          Json
  artDirection   Json
  prompt         String
  model          String
  rodiCost       Float?
  status         GenerationStatus   @default(PENDING)
  outputUrl      String?
  qualityScore   Float?
  qualityDetails Json?
  groupId        String?
  variant        GenerationVariant?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id])
  group          GenerationGroup?   @relation(fields: [groupId], references: [id])
  supportTickets SupportTicket[]

  @@index([groupId])
}

model Referral {
  id             String         @id @default(cuid())
  referrerUserId String
  referredUserId String         @unique
  code           String
  status         ReferralStatus @default(PENDING)
  rewardedAt     DateTime?
  createdAt      DateTime       @default(now())
  referrer       User           @relation("Referrer", fields: [referrerUserId], references: [id])
  referred       User           @relation("Referred", fields: [referredUserId], references: [id])

  @@index([referrerUserId, createdAt])
}

model SeasonalCampaign {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  startDate    DateTime?
  endDate      DateTime?
  markets      String[]
  domains      String[]
  styleProfile Json
  referenceIds String[]
  active       Boolean   @default(false)
  priority     Int       @default(0)
  movable      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Reference {
  id              String   @id @default(cuid())
  domain          String
  style           String?
  composition     String?
  colorPalette    String?
  typography      String?
  imageTreatment  String?
  layout          String?
  density         String?
  mood            String?
  imageUrl        String?
  tags            String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdminLog {
  id         String   @id @default(cuid())
  adminUserId String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  admin      User     @relation("AdminActorLogs", fields: [adminUserId], references: [id])
}

model PendingMintGrant {
  id          String                 @id @default(cuid())
  email       String
  amount      Int
  reason      String
  adminUserId String
  expiresAt   DateTime?
  status      PendingMintGrantStatus @default(PENDING)
  userId      String?
  redeemedAt  DateTime?
  claimKey    String?                @unique
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  admin       User                   @relation("MintGrantAdmin", fields: [adminUserId], references: [id])
  user        User?                  @relation("MintGrantUser", fields: [userId], references: [id])

  @@index([email, status])
  @@index([adminUserId])
}

enum SupportCategory {
  GENERATION
  PAYMENT
  ACCOUNT
  EXPORT
  PERSONAL_REFERENCE
  BUG
  SUGGESTION
  OTHER
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum SupportAuthorType {
  USER
  SUPPORT
}

enum SupportEmailStatus {
  PENDING
  SENT
  FAILED
}

model SupportSequence {
  id   Int @id
  next Int @default(1)
}

model SupportTicket {
  id              String            @id @default(cuid())
  ticketNumber    String            @unique
  userId          String
  subject         String
  category        SupportCategory
  priority        SupportPriority   @default(MEDIUM)
  status          SupportStatus     @default(OPEN)
  generationId    String?
  paymentId       String?
  context         Json?
  clientRequestId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  resolvedAt      DateTime?
  closedAt        DateTime?
  user            User              @relation(fields: [userId], references: [id])
  generation      Generation?       @relation(fields: [generationId], references: [id])
  payment         Payment?          @relation(fields: [paymentId], references: [id])
  messages        SupportMessage[]
  attachments     SupportAttachment[]
  emailEvents     SupportEmailEvent[]

  @@unique([userId, clientRequestId])
  @@index([userId, updatedAt])
  @@index([status, priority, updatedAt])
}

model SupportMessage {
  id          String              @id @default(cuid())
  ticketId    String
  authorId    String
  authorType  SupportAuthorType
  content     String
  isInternal  Boolean             @default(false)
  createdAt   DateTime            @default(now())
  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments SupportAttachment[]

  @@index([ticketId, createdAt])
}

model SupportAttachment {
  id         String          @id @default(cuid())
  ticketId   String
  messageId  String?
  storageKey String          @unique
  fileName   String
  mimeType   String
  size       Int
  bytes      Bytes
  createdAt  DateTime        @default(now())
  ticket     SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message    SupportMessage? @relation(fields: [messageId], references: [id])

  @@index([ticketId])
}

model SupportEmailEvent {
  id                String             @id @default(cuid())
  ticketId          String
  messageId         String?
  eventType         String
  eventKey          String             @unique
  status            SupportEmailStatus @default(PENDING)
  providerMessageId String?
  attempts          Int                @default(0)
  lastError         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  ticket            SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model PromoCode {
  id          String            @id @default(cuid())
  code        String            @unique
  mintAmount  Int
  maxUses     Int
  usedCount   Int               @default(0)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  redemptions PromoRedemption[]
}

model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  userId      String
  mintAmount  Int
  createdAt   DateTime  @default(now())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])
  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  dedupeKey String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  eventKey  String   @unique
  payload   Json
  createdAt DateTime @default(now())

  @@index([provider, createdAt])
}
