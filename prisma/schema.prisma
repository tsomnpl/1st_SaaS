generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
  FAILED
}

enum CreditTransactionType {
  FREE_GRANT
  PURCHASE
  GENERATION
  REFUND
  BONUS
  ADMIN_ADD
  ADMIN_REMOVE
  EXPIRATION
}

enum GenerationStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id                 String              @id @default(cuid())
  clerkUserId        String              @unique
  email              String?
  name               String?
  role               UserRole            @default(USER)
  status             UserStatus          @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  creditAccount      CreditAccount?
  creditBuckets      CreditBucket[]
  creditTransactions CreditTransaction[]
  payments           Payment[]
  generations        Generation[]
  brandKit           BrandKit?
  adminLogs          AdminLog[]          @relation("AdminActorLogs")
  tickets            Ticket[]            @relation("TicketOwner")
  ticketMessages     TicketMessage[]
  ticketAttachments  TicketAttachment[]
  ticketAssignments  TicketAssignment[]  @relation("TicketAssignee")
  notifications      Notification[]
  notificationPreference NotificationPreference?
  feedbacks          GenerationFeedback[]
  suggestions        Suggestion[]
  suggestionVotes    SuggestionVote[]
  incidents          Incident[]
}

model Plan {
  id             String    @id @default(cuid())
  code           String    @unique
  name           String
  priceFcfa      Int
  mintAmount     Int
  durationDays   Int?
  editableExport Boolean   @default(false)
  active         Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payments       Payment[]
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  planId         String
  orderId        String        @unique
  tokenPay       String?       @unique
  amountFcfa     Int
  provider       String        @default("MONEY_FUSION")
  status         PaymentStatus @default(PENDING)
  rawStatus      String?
  rawResponse    Json?
  webhookState   String?
  creditedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  plan           Plan          @relation(fields: [planId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  tickets        Ticket[]
}

model CreditAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  balance      Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id])
}

model CreditBucket {
  id                 String   @id @default(cuid())
  userId             String
  sourceTransactionId String
  sourceType         CreditTransactionType
  totalAmount        Int
  remainingAmount    Int
  expiresAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt, remainingAmount])
}

model CreditTransaction {
  id            String                @id @default(cuid())
  userId        String
  type          CreditTransactionType
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  reference     String?
  metadata      Json?
  createdAt     DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model BrandKit {
  id        String   @id @default(cuid())
  userId    String   @unique
  colors    String[]
  logoUrl   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Generation {
  id             String           @id @default(cuid())
  userId         String
  mintCost       Int              @default(1)
  brief          Json
  artDirection   Json
  prompt         String
  model          String
  rodiCost       Float?
  status         GenerationStatus @default(PENDING)
  outputUrl      String?
  qualityScore   Float?
  qualityDetails Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id])
  tickets        Ticket[]
  feedback       GenerationFeedback?
  incidents      Incident[]
}

model Reference {
  id              String   @id @default(cuid())
  domain          String
  style           String?
  composition     String?
  colorPalette    String?
  typography      String?
  imageTreatment  String?
  layout          String?
  density         String?
  mood            String?
  imageUrl        String?
  tags            String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdminLog {
  id         String   @id @default(cuid())
  adminUserId String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  admin      User     @relation("AdminActorLogs", fields: [adminUserId], references: [id])
}

model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  eventKey  String   @unique
  payload   Json
  createdAt DateTime @default(now())

  @@index([provider, createdAt])
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketCategory {
  GENERATION
  PAYMENT
  MINTS
  ACCOUNT
  EXPORT
  PERSONAL_REFERENCE
  BUG
  FEATURE_REQUEST
  OTHER
}

enum SupportQueue {
  SUPPORT
  BILLING
  TECHNICAL
  ADMIN
}

enum MessageVisibility {
  PUBLIC
  INTERNAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  MITIGATED
  RESOLVED
  CLOSED
}

enum IncidentSeverity {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum SuggestionCategory {
  FEATURE
  DESIGN
  GENERATION
  EXPORT
  SUPPORT
  OTHER
}

enum SuggestionStatus {
  NEW
  REVIEWING
  PLANNED
  IN_PROGRESS
  RELEASED
  DECLINED
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

model Ticket {
  id              String         @id @default(cuid())
  publicId        String         @unique
  userId          String
  subject         String
  category        TicketCategory
  priority        TicketPriority @default(NORMAL)
  status          TicketStatus   @default(NEW)
  generationId    String?
  paymentId       String?
  contextPublic   Json?
  contextInternal Json?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  csatScore       Int?
  csatComment     String?
  csatAskedAt     DateTime?
  csatAnsweredAt  DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation("TicketOwner", fields: [userId], references: [id])
  generation      Generation?    @relation(fields: [generationId], references: [id])
  payment         Payment?       @relation(fields: [paymentId], references: [id])
  messages        TicketMessage[]
  attachments     TicketAttachment[]
  assignments     TicketAssignment[]
  events          TicketEvent[]

  @@index([userId, createdAt])
  @@index([status, priority, createdAt])
  @@index([category, createdAt])
  @@index([generationId])
  @@index([paymentId])
}

model TicketMessage {
  id           String            @id @default(cuid())
  ticketId     String
  authorUserId String
  body         String
  visibility   MessageVisibility @default(PUBLIC)
  createdAt    DateTime          @default(now())
  ticket       Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User              @relation(fields: [authorUserId], references: [id])

  @@index([ticketId, createdAt])
  @@index([visibility])
}

model TicketAttachment {
  id               String   @id @default(cuid())
  ticketId         String
  uploadedByUserId String
  storageKey       String
  fileName         String
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime @default(now())
  ticket           Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy       User     @relation(fields: [uploadedByUserId], references: [id])

  @@index([ticketId])
}

model TicketAssignment {
  id             String       @id @default(cuid())
  ticketId       String
  queue          SupportQueue
  assigneeUserId String?
  createdAt      DateTime     @default(now())
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignee       User?        @relation("TicketAssignee", fields: [assigneeUserId], references: [id])

  @@index([ticketId])
  @@index([queue])
  @@index([assigneeUserId])
}

model TicketEvent {
  id          String   @id @default(cuid())
  ticketId    String
  type        String
  actorUserId String?
  payload     Json?
  createdAt   DateTime @default(now())
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  dedupeKey String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  emailTickets     Boolean @default(true)
  emailGenerations Boolean @default(true)
  emailPayments    Boolean @default(true)
  emailMints       Boolean @default(true)
  user             User    @relation(fields: [userId], references: [id])
}

model GenerationFeedback {
  id           String   @id @default(cuid())
  generationId String   @unique
  userId       String
  rating       Int?
  comment      String?
  dismissed    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  generation   Generation @relation(fields: [generationId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Suggestion {
  id        String             @id @default(cuid())
  userId    String
  category  SuggestionCategory
  title     String
  body      String
  status    SuggestionStatus   @default(NEW)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id])
  votes     SuggestionVote[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([category])
}

model SuggestionVote {
  id           String     @id @default(cuid())
  suggestionId String
  userId       String
  createdAt    DateTime   @default(now())
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])

  @@unique([suggestionId, userId])
}

model Incident {
  id           String           @id @default(cuid())
  publicId     String           @unique
  type         String
  severity     IncidentSeverity @default(NORMAL)
  status       IncidentStatus   @default(OPEN)
  service      String
  summary      String
  detail       String?
  userId       String?
  generationId String?
  paymentId    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  resolvedAt   DateTime?
  user         User?            @relation(fields: [userId], references: [id])
  generation   Generation?      @relation(fields: [generationId], references: [id])

  @@index([status, severity, createdAt])
  @@index([type, createdAt])
  @@index([generationId])
  @@index([userId])
}

model EmailOutbox {
  id             String      @id @default(cuid())
  idempotencyKey String      @unique
  template       String
  toAddress      String
  subject        String
  payload        Json
  status         EmailStatus @default(QUEUED)
  attempts       Int         @default(0)
  lastError      String?
  nextAttemptAt  DateTime    @default(now())
  sentAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, nextAttemptAt])
}
