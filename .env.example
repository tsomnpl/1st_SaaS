NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/post-auth
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/post-auth

DATABASE_URL=

RODIUMAI_API_KEY=
RODIUMAI_BASE_URL=https://api.rodiumai.io/v1
RODIUMAI_MODEL=
RODIUMAI_TEXT_MODEL=google/gemini-3.5-flash
RODIUMAI_IMAGE_MODEL_FAST=openai/gpt-image-1-mini
RODIUMAI_IMAGE_MODEL_PREMIUM=openai/gpt-image-2
RODIUMAI_IMAGE_MODEL_TEXT_HEAVY=openai/gpt-image-2
RODIUMAI_IMAGE_MODEL_IMAGE_EDIT=google/gemini-3.1-flash-image
RODIUMAI_ALLOWED_IMAGE_MODELS=

MONEY_FUSION_API_URL=
MONEY_FUSION_WEBHOOK_URL=http://localhost:3000/api/webhooks/moneyfusion

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated clerk user IDs with admin rights (optional fallback)
ADMIN_CLERK_USER_IDS=

# Primary admin identity — never commit a real address
ADMIN_EMAIL=

# Optional extra admin URL /c/<ADMIN_PRIVATE_PATH> — no fallback if empty
ADMIN_PRIVATE_PATH=

# Optional Plausible domain, loaded only after cookie consent
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Transactional email. Provider: outbox (log only) or resend.
# EMAIL_FROM must use a domain verified in Resend; onboarding@resend.dev works for dev only.
EMAIL_PROVIDER=resend
EMAIL_FROM="FlyerMint <support@ton-domaine.com>"
EMAIL_REPLY_TO=support@ton-domaine.com
SUPPORT_EMAIL=support@ton-domaine.com
BILLING_EMAIL=facturation@ton-domaine.com
TECHNICAL_EMAIL=technique@ton-domaine.com
RESEND_API_KEY=
# openssl rand -hex 32
CRON_SECRET=
# International format, digits only (e.g. 22990000000); shown as a wa.me link on /support and in emails.
SUPPORT_WHATSAPP_NUMBER=

# Monitoring thresholds
MONITOR_MIN_SAMPLE=20
MONITOR_GEN_FAILURE_RATE=0.15
MONITOR_WEBHOOK_FAILURES=5
MONITOR_SLOW_GENERATION_MS=60000
