NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

DATABASE_URL=

RODIUMAI_API_KEY=
RODIUMAI_BASE_URL=https://api.rodiumai.io/v1
RODIUMAI_MODEL=
RODIUMAI_TEXT_MODEL=google/gemini-3.5-flash
RODIUMAI_IMAGE_MODEL_FAST=openai/gpt-image-1-mini
RODIUMAI_IMAGE_MODEL_PREMIUM=openai/gpt-image-2
RODIUMAI_IMAGE_MODEL_TEXT_HEAVY=openai/gpt-image-2
RODIUMAI_IMAGE_MODEL_IMAGE_EDIT=google/gemini-3.1-flash-image
RODIUMAI_ALLOWED_IMAGE_MODELS=

MONEY_FUSION_API_URL=
MONEY_FUSION_WEBHOOK_URL=http://localhost:3000/api/webhooks/moneyfusion

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Real launch instant, ISO date. Leave empty until the real launch.
# The 2 000 FCFA pack stays visible until 30 days after this instant. Its Mints do not expire.
APP_LAUNCH_AT=

# Clerk user IDs allowed into the admin studio. Comma-separated.
ADMIN_CLERK_USER_IDS=

# Admin and support inbox. Set this in the host environment, never in git.
# A matching verified Clerk email can open the studio. The same inbox receives operational mail.
ADMIN_EMAIL=

# Gmail SMTP, server only. Never prefix these with NEXT_PUBLIC_ and never commit the app password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=FlyerMint

# Required in production. The studio lives at /c/<ADMIN_PRIVATE_PATH>.
# There is no default. An empty value closes the studio.
ADMIN_PRIVATE_PATH=

# Optional Plausible domain, loaded only after cookie consent
NEXT_PUBLIC_ANALYTICS_DOMAIN=
